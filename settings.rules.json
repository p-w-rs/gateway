{
  "_comment": "Permission rules gateway expects in your user settings.json. `pixi run install` merges them for you; {PLUGIN_DIR} becomes the plugin's path. The 'ask' rules are what make Claude Code prompt for port_check, for root commands when sudo is disabled, and for git_confirm/gh_confirm (calls an account's policy says to ask about), so keep them. Read(~/.config/age/**), Read(~/.config/secrets/**) and Bash(secret:*) protect a personal age-based secret store if you have one; harmless otherwise.",
  "permissions": {
    "allow": [
      "mcp__plugin_gate_gw__http_request",
      "mcp__plugin_gate_gw__download",
      "mcp__plugin_gate_gw__cert_inspect",
      "mcp__plugin_gate_gw__file_hash",
      "mcp__plugin_gate_gw__run_privileged",
      "mcp__plugin_gate_gw__secret_list",
      "mcp__plugin_gate_gw__secret_use",
      "mcp__plugin_gate_gw__account_list",
      "mcp__plugin_gate_gw__git",
      "mcp__plugin_gate_gw__git_identity",
      "mcp__plugin_gate_gw__gh",
      "mcp__plugin_gate_gw__git_mirror",
      "mcp__plugin_gate_gw__hf",
      "mcp__plugin_gate_gw__pijul",
      "mcp__plugin_gate_gw__ssh_exec",
      "mcp__plugin_gate_gw__ssh_copy",
      "mcp__plugin_gate_gw__databricks",
      "mcp__plugin_gate_gw__mlcat",
      "mcp__plugin_gate_gw__mlcat_workspace",
      "mcp__plugin_gate_gw__registry"
    ],
    "ask": [
      "mcp__plugin_gate_gw__port_check",
      "mcp__plugin_gate_gw__run_privileged_confirm",
      "mcp__plugin_gate_gw__git_confirm",
      "mcp__plugin_gate_gw__gh_confirm",
      "mcp__plugin_gate_gw__hf_confirm",
      "mcp__plugin_gate_gw__pijul_confirm",
      "mcp__plugin_gate_gw__ssh_exec_confirm",
      "mcp__plugin_gate_gw__ssh_copy_confirm",
      "mcp__plugin_gate_gw__databricks_confirm",
      "mcp__plugin_gate_gw__mlcat_workspace_confirm",
      "mcp__plugin_gate_gw__registry_confirm"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(security:*)",
      "Bash(nmap:*)",
      "Bash(masscan:*)",
      "Bash(certutil:*)",
      "Bash(cmdkey:*)",
      "Bash(age:*)",
      "Bash(secret:*)",
      "Read(~/.config/age/**)",
      "Read(~/.config/secrets/**)",
      "Read(~/.config/gateway/**)",
      "Edit(~/.config/gateway/**)",
      "Edit({PLUGIN_DIR}/config/**)"
    ]
  },
  "_strict_comment": "Merged only by `pixi run install --strict` (undo: --unstrict). env: your own credentials are blanked for Claude Code's processes only (your terminal is unaffected), so nothing Claude runs can fall back to them; the gateway's account tools bring their own. deny: the usual places tools keep credentials. Strict also sets takeover=true in config/policy.json.",
  "strict": {
    "env": {
      "SSH_AUTH_SOCK": "",
      "SSH_ASKPASS": "",
      "GIT_ASKPASS": "",
      "GITHUB_TOKEN": "",
      "GH_TOKEN": "",
      "GH_ENTERPRISE_TOKEN": "",
      "GITHUB_ENTERPRISE_TOKEN": "",
      "HF_TOKEN": "",
      "HUGGING_FACE_HUB_TOKEN": "",
      "AZURE_STORAGE_KEY": "",
      "AZURE_STORAGE_SAS_TOKEN": "",
      "AZURE_STORAGE_CONNECTION_STRING": "",
      "AZURE_CLIENT_SECRET": "",
      "ARM_CLIENT_SECRET": "",
      "DATABRICKS_TOKEN": "",
      "DOCKER_AUTH_CONFIG": ""
    },
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.cache/huggingface/stored_tokens)",
      "Read(~/.huggingface/token)",
      "Read(~/.azure/**)",
      "Read(~/.databrickscfg)",
      "Read(~/.databricks/**)",
      "Read(~/.config/pijul/identities/**)",
      "Read(~/.local/share/ASI/asiml/**)",
      "Bash(git credential:*)",
      "Bash(gh auth token:*)",
      "Bash(hf auth token:*)",
      "Bash(az account get-access-token:*)"
    ]
  }
}
