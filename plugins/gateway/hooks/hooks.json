{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pixi run --manifest-path \"${CLAUDE_PLUGIN_ROOT}/pixi.toml\" --frozen python \"${CLAUDE_PLUGIN_ROOT}/run.py\" hook-session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt.sh\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 330
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pixi run --manifest-path \"${CLAUDE_PLUGIN_ROOT}/pixi.toml\" --frozen python \"${CLAUDE_PLUGIN_ROOT}/run.py\" hook-route",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__plugin_gate_gw__.*|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/perm.sh\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
