#!/bin/sh
# gate-sh: the gateway's CLAUDE_CODE_SHELL_PREFIX (PLAN-v4 phase 4; PLAN-0.11
# §1.6; docs/dev/modules/managed.md). POSIX sh. The gateway mod sets the
# prefix to this file at session start in managed mode ([shell] managed =
# "on", the default), with GW_MANAGED_DIR naming the folder Python writes the
# managed shell's files to.
#
# Claude Code runs every shell command it starts through the prefix with ONE
# argument (FEASIBILITY-v4 P2; the forms below were recorded on 2.1.301):
#
#  * a classic hook's command string (and an MCP server's quoted argv, a
#    status line command, ...), which Claude Code would otherwise run as
#    `/bin/sh -c STRING`: run exactly that way, with the same stdin, stdout,
#    stderr, environment and exit status (nothing but builtins runs first);
#
#  * a Bash-tool script (the Bash tool, run_in_background, Monitor, the
#    user's ! commands, subagents, skills' ! injection; bash or zsh alike):
#
#      source <cfg>/shell-snapshots/snapshot-<shell>-*.sh 2>/dev/null || true && \
#      <other plugins' CLAUDE_ENV_FILE text> ... && eval '<command>' [< /dev/null] && \
#      pwd -P >| <tmp>/claude-XXXX-cwd
#
#    It runs under the gateway env's bash 5 (--noprofile --norc) with the
#    user's own environment: the inherited variables minus, by name (`env
#    -u NAME`, so no value ever reaches a command line, which every local
#    user can read), Claude Code's own credential variables, the variables
#    that make a shell run code at startup or change its parsing (BASH_ENV,
#    ENV, BASH_FUNC_*, SHELLOPTS, BASHOPTS, PS4, PROMPT_COMMAND, CDPATH, IFS,
#    GLOBIGNORE, BASH_XTRACEFD) and the gateway's internal GW_* names but
#    GW_MANAGED_DIR (managed.py holds the same lists; a test compares). PATH
#    is the present stand-ins, then the snapshot's PATH (its `export PATH=`
#    line, read, never sourced; the inherited PATH without a snapshot), then
#    other plugins' bin/ folders, then the approved import_path. The
#    snapshot's `source` is replaced by the gateway's rc, which sources a
#    bash snapshot (the user's aliases, functions and options; a zsh one
#    gives only its PATH), re-asserts PATH and ends by removing every alias
#    and function named after a present stand-in (in POSIX mode), so nothing
#    shadows the stand-ins. The rest (the env-file text, Claude Code's own
#    segments, the eval'd command, the cwd tracker) runs unchanged. The
#    command's exit status is bash's, and exec keeps one process (Claude
#    Code's interrupt and timeout kill it).
#
# A string that has the shape of a Bash-tool script but doesn't parse (exit
# 126) is reported on stderr and NOT run. A managed shell that isn't ready
# (building, failed, its settings missing) runs the script without the
# gateway's settings instead, byte for byte (the snapshot's `source`
# included), in the shell that made the snapshot, found the way Claude Code
# finds its shell (gw_fallback_shell: never /bin/sh, where dash has no
# `source`), with the same removals, and says so on stderr; with no such
# shell it is refused (126). The managed shell is a convenience (PLAN-0.11
# §1.6, §19.15), and the approval hook judged the command already.

# Hook strings first, with builtins only and no variable assigned (exactness:
# a variable set here would reach the hook if its name were exported):
# anything without a Bash-tool script's shape goes to /bin/sh -c, as Claude
# Code runs it without a prefix.
if [ "$#" -ne 1 ]; then
  printf '%s\n' "gateway: the managed shell (gate-sh) was called with $# arguments instead of one; nothing was run" >&2
  exit 126
fi
# A Bash-tool script: Claude Code's snapshot source as its first segment
# (refused below when the rest of the shape is missing), or else the whole
# shape: the cwd tracker as the last segment (one word naming a -cwd file,
# bare or quoted) and an eval of the command.
gw_tool_shape() {
  case $1 in 'source '*/shell-snapshots/snapshot-*) return 0 ;; esac
  case $1 in *' && pwd -P >| '*) ;; *) return 1 ;; esac
  case ${1##*' && pwd -P >| '} in
  \'*-cwd\') ;;
  '' | *[!A-Za-z0-9@%+=:,./_-]*) return 1 ;;
  *-cwd) ;;
  *) return 1 ;;
  esac
  case $1 in 'eval '* | *' && eval '*) return 0 ;; esac
  return 1
}
if ! gw_tool_shape "$1"; then
  # macOS's /bin/sh is bash, which counts itself in SHLVL: the shell that
  # started this file and this file's own shell are one level each where
  # Claude Code's /bin/sh is one, so give one back (dash leaves SHLVL alone).
  if [ -n "${BASH_VERSION-}" ]; then
    case ${SHLVL-} in '' | *[!0-9]*) ;; *) [ "$SHLVL" -gt 0 ] && SHLVL=$((SHLVL - 1)) ;; esac
  fi
  exec /bin/sh -c "$1"
fi

GW_PATH0=${PATH-}                    # Claude Code's PATH (pixi's place, the fallback, no snapshot)
PATH=/usr/bin:/bin:/usr/sbin:/sbin   # this file's own helpers (sed, env); not the command's
# the default IFS (space, tab, newline): an inherited one never splits anything here
IFS=$(printf ' \t\nx')
IFS=${IFS%x}
GW_SCRIPT=$1
GW_BASH=

gw_unknown() {
  printf '%s\n' "gateway: the managed shell doesn't recognize how Claude Code asked to run this command ($1); it was not run, in the managed shell or your own. /gate-doctor shows the managed shell's state; the user can switch it off with [shell] managed = \"off\" in gateway.toml (that needs their OK in the gateway's dialog)." >&2
  exit 126
}

# Is the build lock $1 (launch.sh's $ENVD.building) held by a live builder?
# Builtins only: its `owner` file read with `read`, the builder's and its pixi
# child's pids tested with `kill -0`. A lock with no owner file yet (the
# instant after mkdir) counts as live. launch.sh's lock_live also compares
# start times and the machine id (ps, ioreg); without them a reused pid looks
# alive here (still setting up, as before), never the other way round.
gw_lock_live() {
  [ -f "$1/owner" ] || return 0
  _pid= _child=
  while IFS='=' read -r _k _v; do
    case $_k in pid) _pid=$_v ;; child) _child=$_v ;; esac
  done < "$1/owner"
  case $_pid in ''|*[!0-9]*) ;; *) kill -0 "$_pid" 2>/dev/null && return 0 ;; esac
  case $_child in ''|*[!0-9]*) ;; *) kill -0 "$_child" 2>/dev/null && return 0 ;; esac
  return 1
}

# Why the gateway's settings can't be used, from file tests alone (no
# process is started): its data folder gone (uninstalled, or the folder
# removed), a build running (a live lock: gw_lock_live), its setup failed (an
# env folder with install.log and no .ready, no live build lock), an env
# already built (then its settings are what is missing or wasn't renewed),
# pixi missing (launch.sh's find_pixi places), or else still setting up (no
# build has started yet). launch.sh's not_ready_text tells the stand-ins the
# same states apart; the failed and pixi-missing sentences are its own
# (tests/test_managed.py compares them).
gw_setup_state() {
  set +f
  _data=${GW_MANAGED_DIR%/managed}
  if [ ! -d "$_data" ]; then
    printf '%s' "The gateway's data folder ($_data) is gone: the gateway was uninstalled or its folder removed. Tell the user to restart Claude Code (quit every open session and start a new one) to work without it, or to reinstall it (/plugin install gate@gateway) and start a new session."
    return 0
  fi
  # the env the settings name while it is there, else every env (an update's
  # new one among them)
  set -- "$_data"/envs/*
  case $GW_BASH in
  /*/.pixi/envs/default/bin/bash)
    _d=${GW_BASH%/.pixi/envs/default/bin/bash}
    if [ -d "$_d" ] || [ -d "$_d.building" ]; then set -- "$_d"; fi ;;
  esac
  _log= _building=
  for _d in "$@"; do
    # a build is running (a stale lock, its builder gone, doesn't count:
    # launch.sh's next start takes it over)
    if [ -d "$_d.building" ] && gw_lock_live "$_d.building"; then _log= _building=1; break; fi
    if [ -z "$_log" ] && [ -f "$_d/install.log" ] && [ ! -e "$_d/.ready" ]; then _log=$_d/install.log; fi
  done
  if [ -n "$_log" ]; then
    printf '%s' "The gateway's setup failed (log: $_log); it is retried at the next session start; tell the user (/gate-doctor shows why)."
    return 0
  fi
  # an env that is built (launch.sh's ready test) and no build running: its
  # settings are what is missing or wasn't renewed
  [ -n "$_building" ] || for _d in "$@"; do
    if [ -e "$_d/.ready" ] && [ -x "$_d/.pixi/envs/default/bin/python3" ]; then
      printf '%s' "The managed shell's settings are missing or couldn't be renewed; a new session writes them again (/gate-doctor shows their state)."
      return 0
    fi
  done
  _pixi=
  _ifs=$IFS
  IFS=:
  set -f
  for _d in $GW_PATH0 "${PIXI_HOME:-${HOME:-}/.pixi}/bin" "${HOME:-}/.local/bin" /opt/homebrew/bin \
            /usr/local/bin /opt/local/bin /home/linuxbrew/.linuxbrew/bin; do
    if [ -n "$_d" ] && [ -x "$_d/pixi" ] && [ ! -d "$_d/pixi" ]; then _pixi=$_d/pixi; break; fi
  done
  set +f
  IFS=$_ifs
  if [ -z "$_pixi" ]; then
    printf '%s' "The gateway can't set itself up: pixi isn't installed; tell the user to install it from https://pixi.sh and start a new session."
    return 0
  fi
  printf '%s' "The gateway is still setting up (on a first run, about a minute); /gate-doctor shows its progress."
}

# A word as Claude Code quotes it: bare, or '...' with '"'"' for a quote.
gw_unquote() {
  case $1 in
  \'*\')
    _u=${1#\'}
    _u=${_u%\'}
    case $_u in
    *\'*) printf '%s' "$_u" | sed "s/'\"'\"'/'/g" ;;
    *) printf '%s' "$_u" ;;
    esac ;;
  *\'* | *\"* | *' '*) return 1 ;;
  *) printf '%s' "$1" ;;
  esac
}

# The cwd tracker: the last segment, a file Claude Code reads back.
case $GW_SCRIPT in *' && pwd -P >| '*) ;; *) gw_unknown "no working-directory tracker at its end" ;; esac
GW_CWDQ=${GW_SCRIPT##*' && pwd -P >| '}
case $GW_CWDQ in
*"
"*) gw_unknown "a line break after the working-directory tracker" ;;
\'*-cwd\') ;;
'' | *[!A-Za-z0-9@%+=:,./_-]*) gw_unknown "no working-directory tracker at its end" ;;
*-cwd) ;;
*) gw_unknown "no working-directory tracker at its end" ;;
esac
case $GW_SCRIPT in
'eval '* | *' && eval '*) ;;
*) gw_unknown "no eval of the command" ;;
esac

# The snapshot's source, replaced by the gateway's rc. Without a snapshot
# (Claude Code couldn't make one) the script has no source segment.
GW_SNAP=
GW_BODY=$GW_SCRIPT
case $GW_SCRIPT in
'source '*)
  _r=${GW_SCRIPT#source }
  case $_r in *' 2>/dev/null || true && '*) ;; *) gw_unknown "an unexpected first segment" ;; esac
  _q=${_r%%' 2>/dev/null || true && '*}
  GW_BODY=${_r#*' 2>/dev/null || true && '}
  GW_SNAP=$(gw_unquote "$_q") || gw_unknown "an unexpected snapshot path"
  case $GW_SNAP in
  /*/shell-snapshots/snapshot-*.sh) ;;
  *) gw_unknown "a source of something other than Claude Code's shell snapshot" ;;
  esac ;;
*/shell-snapshots/snapshot-*) gw_unknown "a shell snapshot outside the first segment" ;;
esac

# The environment's removals (PLAN-0.11 §1.6): every name in the environment
# this shell gives its children (one per line that holds a '='; a line of a
# value that spans lines can add a name that isn't there, which `env -u`
# ignores) that is Claude Code's own credential (a CLAUDE_* or ANTHROPIC_*
# name with a credential word, or one of the fixed list), a variable that
# makes a shell run code at startup or changes its parsing, a GW_* name but
# GW_MANAGED_DIR, or a name no shell takes as a variable (BASH_FUNC_ssh%%):
# collected in GW_DROP as `-u NAME` words (only names reach env's command
# line, never a value). A name holding a blank (no shell imports one) stays.
GW_FIXED_DROP=' CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_CLIENT_KEY CLAUDE_CODE_CLIENT_KEY_PASSPHRASE CLAUDE_CODE_CLIENT_CERT CLAUDE_CODE_HOST_CREDS_FILE ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN BASH_ENV ENV SHELLOPTS BASHOPTS PS4 PROMPT_COMMAND CDPATH IFS GLOBIGNORE BASH_XTRACEFD '
gw_credlike() {
  case $1 in
  *TOKEN* | *SECRET* | *PASSW* | *PASSPHRASE* | *CRED* | *API_KEY* | *APIKEY* | *ACCESS_KEY* | *PRIVATE_KEY* | *CLIENT_KEY* | *CLIENT_CERT* | *AUTH* | *COOKIE* | *SESSION_KEY*) return 0 ;;
  esac
  return 1
}
# (Without the list nothing would be removed, Claude Code's credentials
# included: refuse instead, in either shell.)
if ! GW_ENVTEXT=$(env); then
  printf '%s\n' "gateway: the managed shell couldn't list the environment (env failed), so it can't remove Claude Code's own credentials from it; the command was not run. /gate-doctor shows the managed shell's state." >&2
  exit 126
fi
GW_DROP=
# Whether SHELL is in the environment (Claude Code's): bash run as sh (macOS's
# /bin/sh) sets one of its own when there is none, the login shell, unexported.
GW_SHELL_SET=
set -f
_ifs=$IFS
IFS='
'
for _l in $GW_ENVTEXT; do
  case $_l in [!=]*=*) ;; *) continue ;; esac
  _n=${_l%%=*}
  [ "$_n" = SHELL ] && GW_SHELL_SET=1
  case $_n in
  *[' 	']*) continue ;;                                  # no shell takes it: inert
  GW_MANAGED_DIR) continue ;;
  GW_* | BASH_FUNC_* | *[!A-Za-z0-9_]* | [0-9]*) ;;           # dropped
  CLAUDE_* | ANTHROPIC_*) gw_credlike "$_n" || case $GW_FIXED_DROP in *" $_n "*) ;; *) continue ;; esac ;;
  *) case $GW_FIXED_DROP in *" $_n "*) ;; *) continue ;; esac ;;
  esac
  GW_DROP="$GW_DROP -u $_n"
done
IFS=$_ifs
set +f
GW_ENVTEXT=

# The shell that made the script's snapshot: its name says which (Claude
# Code's snapshot-zsh-* or snapshot-bash-*; none without a snapshot).
GW_FAMILY=
case ${GW_SNAP##*/} in snapshot-zsh-*) GW_FAMILY=zsh ;; snapshot-bash-*) GW_FAMILY=bash ;; esac

# Is $1 a shell the not-ready path may run? An absolute path to an
# executable file that Claude Code names zsh (the path holds "zsh") or bash
# (it holds "bash"), the snapshot's shell when there is one, and without '='
# (env would read the path as an assignment).
gw_fits() {
  case $1 in
  *=*) return 1 ;;
  /*zsh*) _f=zsh ;;
  /*bash*) _f=bash ;;
  *) return 1 ;;
  esac
  [ -z "$GW_FAMILY" ] || [ "$_f" = "$GW_FAMILY" ] || return 1
  [ -f "$1" ] && [ -x "$1" ]
}
# The first $1 on Claude Code's PATH (absolute folders without '='), when it fits.
gw_which() {
  for _d in $GW_PATH0; do
    case $_d in *=*) continue ;; /*) ;; *) continue ;; esac
    if [ -f "$_d/$1" ] && [ -x "$_d/$1" ]; then
      gw_fits "$_d/$1" || return 1
      printf '%s' "$_d/$1"
      return 0
    fi
  done
  return 1
}
# The first $1 in Claude Code's usual places that fits (managed.FALLBACK_DIRS).
gw_places() {
  for _d in /bin /usr/bin /usr/local/bin /opt/homebrew/bin; do
    if gw_fits "$_d/$1"; then printf '%s' "$_d/$1"; return 0; fi
  done
  return 1
}
# The shell that made the script's snapshot, found the way Claude Code finds
# its shell (2.1.310): CLAUDE_CODE_SHELL, then SHELL (as Claude Code has it,
# in the environment), then the preferred shell on PATH, the usual places for
# it, the usual places for the other, the other on PATH; bash is preferred
# when SHELL holds "bash", else zsh. The first that fits (gw_fits: the
# snapshot's shell, when there is a snapshot); managed.fallback_shell is the
# same rule (a test compares). Never /bin/sh: the script sources the
# snapshot, and dash has no `source` (Debian ran the command without it,
# silently). Prints nothing and fails when there is none. (Run in $(...):
# its IFS and set -f stay there.)
gw_fallback_shell() {
  _sh=${GW_SHELL_SET:+${SHELL-}}
  case $_sh in *bash*) set -- bash zsh ;; *) set -- zsh bash ;; esac
  for _c in "${CLAUDE_CODE_SHELL-}" "$_sh"; do
    if gw_fits "$_c"; then printf '%s' "$_c"; return 0; fi
  done
  IFS=:
  set -f
  gw_which "$1" || gw_places "$1" || gw_places "$2" || gw_which "$2"
}

# Not ready: the script without the gateway's settings, byte for byte, with
# the removals, in the shell that made its snapshot; one line on stderr says
# so, in which shell, and why (PLAN-0.11 §1.6, §19.15). $1 names what is
# missing; $2, when given, is what to do (else gw_setup_state says it).
gw_notready() {
  _todo=${2-}
  [ -n "$_todo" ] || _todo=$(gw_setup_state)
  if ! _sh=$(gw_fallback_shell); then
    _need="a bash or zsh"
    [ -z "$GW_FAMILY" ] || _need="a $GW_FAMILY (the shell that made its snapshot)"
    printf '%s\n' "gateway: this command was not run: the managed shell isn't ready ($1), and running it without the gateway's settings needs $_need, but CLAUDE_CODE_SHELL and SHELL name none and none was found on PATH or in /bin, /usr/bin, /usr/local/bin or /opt/homebrew/bin. $_todo" >&2
    exit 126
  fi
  printf '%s\n' "gateway: this command ran without the gateway's managed settings, in $_sh: the managed shell isn't ready ($1). $_todo" >&2
  PATH=$GW_PATH0                     # Claude Code's own PATH, as without the prefix
  set -f
  # shellcheck disable=SC2086  # GW_DROP is `-u NAME` words, split on purpose
  exec /usr/bin/env $GW_DROP "$_sh" -c "$GW_SCRIPT"
}

# The managed shell's files (managed.py writes them at session start, after a
# form change and after an approval): conf holds one KEY=VALUE per line.
case ${GW_MANAGED_DIR-} in
/*) ;;
*) gw_notready "the gateway mod didn't name its managed-shell folder" \
  "CLAUDE_CODE_SHELL_PREFIX names gate-sh, but GW_MANAGED_DIR is missing or not an absolute path; the gateway mod sets both at session start, and a Claude Code started some other way with CLAUDE_CODE_SHELL_PREFIX set by hand needs GW_MANAGED_DIR too, or neither. /gate-doctor shows the gateway's setup." ;;
esac
GW_CONF=$GW_MANAGED_DIR/conf
gw_read_conf() {
  GW_BASH='' GW_RC='' GW_STANDINS='' GW_IMPORTS='' GW_FORM='' GW_SYNC='' GW_UNLOCKED=''
  [ -f "$GW_CONF" ] && [ ! -L "$GW_CONF" ] || return 1
  while IFS= read -r _l || [ -n "$_l" ]; do
    case $_l in
    bash=*) GW_BASH=${_l#bash=} ;;
    rc=*) GW_RC=${_l#rc=} ;;
    standins=*) GW_STANDINS=${_l#standins=} ;;
    imports=*) GW_IMPORTS=${_l#imports=} ;;
    form=*) GW_FORM=${_l#form=} ;;
    sync=*) GW_SYNC=${_l#sync=} ;;
    unlocked=*) GW_UNLOCKED=${_l#unlocked=} ;;
    esac
  done < "$GW_CONF"
  return 0
}
gw_read_conf || gw_notready "its settings haven't been written yet"
# gateway.toml changed after the settings were written (FileChanged didn't
# run yet), or the vault was unlocked since (approved imports are inside it):
# renew them first, so a narrowing applies to this command.
if { [ -n "$GW_FORM" ] && [ "$GW_FORM" -nt "$GW_CONF" ]; } ||
   { [ -n "$GW_UNLOCKED" ] && [ "$GW_UNLOCKED" -nt "$GW_CONF" ]; }; then
  if [ -x "$GW_SYNC" ]; then "$GW_SYNC" < /dev/null > /dev/null 2>&1; fi
  gw_read_conf || gw_notready "its settings couldn't be read"
  if [ -n "$GW_FORM" ] && [ "$GW_FORM" -nt "$GW_CONF" ]; then
    gw_notready "gateway.toml changed and its settings couldn't be renewed"
  fi
fi
case $GW_BASH in /*) ;; *) gw_notready "no managed bash yet" ;; esac
case $GW_BASH in *=*) gw_notready "the managed bash's path holds '='" ;; esac
[ -x "$GW_BASH" ] || gw_notready "the gateway's environment isn't built"
case $GW_RC in /*) ;; *) gw_notready "no rc file yet" ;; esac
[ -f "$GW_RC" ] && [ -r "$GW_RC" ] || gw_notready "its rc file is missing"
case $GW_STANDINS in /*) ;; *) gw_notready "no stand-in folder yet" ;; esac

# PATH: the present stand-ins, then the snapshot's PATH (its `export PATH=`
# line, read, never sourced; the inherited PATH when there is no snapshot or
# no such line), then other plugins' bin/ folders it lacks, then the
# approved imports; each folder once.
GW_SNAPPATH=
if [ -n "$GW_SNAP" ] && [ -f "$GW_SNAP" ] && [ -r "$GW_SNAP" ]; then
  _line=$(sed -n 's/^export PATH=//p' "$GW_SNAP" | tail -n 1)
  case $_line in
  \"*\") _line=${_line#\"}; _line=${_line%\"} ;;
  *) _line=$(gw_unquote "$_line") || _line= ;;
  esac
  GW_SNAPPATH=$_line
fi
[ -n "$GW_SNAPPATH" ] || GW_SNAPPATH=$GW_PATH0
GW_NEWPATH=$GW_STANDINS
gw_addpath() {
  case $1 in /*) ;; *) return 0 ;; esac
  case ":$GW_NEWPATH:" in *":$1:"*) ;; *) GW_NEWPATH="$GW_NEWPATH:$1" ;; esac
}
set -f
_ifs=$IFS
IFS=:
for _d in $GW_SNAPPATH; do gw_addpath "$_d"; done
# other plugins' bin/ folders, which Claude Code puts on PATH through the snapshot
for _d in $GW_PATH0; do
  case $_d in
  /*/bin) if [ -f "${_d%/bin}/.claude-plugin/plugin.json" ]; then gw_addpath "$_d"; fi ;;
  esac
done
for _d in $GW_IMPORTS; do gw_addpath "$_d"; done
IFS=$_ifs
set +f

# a bash snapshot is sourced by the rc (its $1); a zsh one only gave its PATH
GW_RCARG=
case $GW_SNAP in */shell-snapshots/snapshot-bash-*.sh) GW_RCARG=$GW_SNAP ;; esac

gw_q() {
  case $1 in
  *\'*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
  *) printf "'%s'" "$1" ;;
  esac
}
set -f
# shellcheck disable=SC2086  # GW_DROP is `-u NAME` words, split on purpose
exec /usr/bin/env $GW_DROP "PATH=$GW_NEWPATH" "SHELL=$GW_BASH" \
  "$GW_BASH" --noprofile --norc -c ". $(gw_q "$GW_RC") $(gw_q "$GW_RCARG") && $GW_BODY"
